{
  "name": "autoseguro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "chat": "node --env-file-if-exists=.env src/cli.ts",
    "serve": "node --env-file-if-exists=.env src/server.ts",
    "meta:provision": "node --env-file-if-exists=.env src/provision-meta.ts",
    "meta:smoke": "node --env-file-if-exists=.env src/provision-meta.ts --smoke",
    "evaluate": "npm test && node --env-file-if-exists=.env src/evaluate.ts",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.9.0"
  }
}
